# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.

# Claude API key from https://platform.claude.com -> Settings -> API Keys (leave empty for word-list only)
ANTHROPIC_API_KEY=

# Password for the moderator review page (/review.html). Review is off while this is empty.
MODERATOR_TOKEN=

# Optional
# MODERATION_MODEL=claude-haiku-5-5
# MODERATION_SENSITIVITY=balanced
